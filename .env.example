# local | cloud
# cloud HARD-REQUIRES a paired local companion process. Cloud-only is unsupported.
SAFE_CONNECT_MODE=local

SAFE_CONNECT_PORT=8787
SAFE_CONNECT_BIND=127.0.0.1

# Override default ~/.safe-connect
# SAFE_CONNECT_HOME=/path/to/safe-connect-home

# Local vault passphrase (CLI prompts if unset). Do not commit real values.
# SAFE_CONNECT_PASSPHRASE=

# Cloud pairing (from `safe-connect init --mode cloud`)
# SAFE_CONNECT_PAIRING_KEY=
# SAFE_CONNECT_COMPANION_PUBLIC_KEY=

# Cloud broker URL used by the companion CLI
# SAFE_CONNECT_CLOUD_URL=http://127.0.0.1:8787

# Dev/test only: companion auto-approves unwrap grants. Never enable in production.
# SAFE_CONNECT_AUTO_APPROVE=0

# Dev/test only: faster Argon2id (unsafe for real secrets)
# SAFE_CONNECT_KDF=fast
