{
  "name": "@safe-connect/broker",
  "version": "0.1.0",
  "description": "Credential broker for AI agents: browser login fills without secrets entering chat. Local-only or cloud+local companion.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "safe-connect": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "NODE_ENV=test SAFE_CONNECT_KDF=fast tsx --test --test-reporter spec test/*.test.ts",
    "start": "node dist/cli.js serve",
    "cli": "node dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzyjoinci-byte/safe-connect.git"
  },
  "keywords": [
    "credentials",
    "vault",
    "mcp",
    "ai-agents",
    "playwright",
    "argon2id"
  ],
  "author": "zzyjoinci-byte",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zzyjoinci-byte/safe-connect/issues"
  },
  "homepage": "https://github.com/zzyjoinci-byte/safe-connect#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "libsodium-wrappers-sumo": "^0.8.4",
    "playwright": "^1.55.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
